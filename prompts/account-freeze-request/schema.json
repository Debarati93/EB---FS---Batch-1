{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "account-freeze-request resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "action", "affected_accounts", "reason_code", "evidence_summary", "policy_reference"],
  "properties": {
    "ticket_id":        { "type": "string", "pattern": "^T-[0-9]{4,}$" },
    "action":           { "type": "string", "enum": ["freeze", "partial_freeze", "deny"] },
    "affected_accounts":{ "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
    "reason_code":      { "type": "string",
                          "enum": ["fraud_suspected","customer_request","court_order","insufficient_evidence"] },
    "evidence_summary": { "type": "string", "maxLength": 300, "minLength": 1 },
    "policy_reference": { "type": "string", "pattern": "^KB-[0-9]+ §[0-9.]+$",
                          "description": "Added at schema 1.1.0 (Step 5). Forces the model to cite the grounding source it used." }
  }
}
